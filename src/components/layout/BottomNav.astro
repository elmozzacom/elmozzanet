---
const path = Astro.url.pathname;
const isActive = (href: string) =>
	href === "/" ? path === "/" : path.startsWith(href);

const items = [
	{ href: "/", label: "Beranda" },
	{ href: "/layanan", label: "Layanan" },
	{ href: "/jadwal-praktik", label: "Jadwal" },
	{ href: "/lokasi-kontak", label: "Lokasi" }
];
---

<nav class="bottom-nav" aria-label="Navigasi utama seluler">
	{
		items.map((item) => (
			<a
				href={item.href}
				class:list={["bn-item", { "is-active": isActive(item.href) }]}
				aria-current={isActive(item.href) ? "page" : undefined}
			>
				<span class="bn-icon" aria-hidden="true">
					{item.href === "/" && (
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
							<path d="M3 10.5 12 3l9 7.5" />
							<path d="M5.5 9.5V20a1 1 0 0 0 1 1H10v-6h4v6h3.5a1 1 0 0 0 1-1V9.5" />
						</svg>
					)}
					{item.href === "/layanan" && (
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
							<path d="M12 20.5s-7-4.35-7-9.4A4.1 4.1 0 0 1 12 8.4a4.1 4.1 0 0 1 7 2.7c0 5.05-7 9.4-7 9.4Z" />
						</svg>
					)}
					{item.href === "/jadwal-praktik" && (
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
							<rect x="3.5" y="5" width="17" height="15.5" rx="2.5" />
							<path d="M3.5 9.5h17M8 3.5V6.5M16 3.5V6.5" />
						</svg>
					)}
					{item.href === "/lokasi-kontak" && (
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
							<path d="M12 21s7-5.4 7-10.6A7 7 0 0 0 5 10.4C5 15.6 12 21 12 21Z" />
							<circle cx="12" cy="10.3" r="2.6" />
						</svg>
					)}
				</span>
				<span class="bn-label">{item.label}</span>
			</a>
		))
	}

	<a
		class="bn-item bn-cta"
		href="https://wa.me/628111712718"
		target="_blank"
		rel="noopener noreferrer"
	>
		<span class="bn-icon" aria-hidden="true">
			<svg viewBox="0 0 24 24" role="img">
				<path
					d="M12.04 2C6.54 2 2.07 6.47 2.07 11.97c0 1.76.46 3.46 1.33 4.95L2 22l5.23-1.37a9.92 9.92 0 0 0 4.81 1.24h.01c5.5 0 9.97-4.47 9.97-9.97S17.55 2 12.04 2Zm4.45 11.99c-.24-.12-1.43-.71-1.65-.79-.22-.08-.38-.12-.54.12-.16.24-.62.79-.76.95-.14.16-.28.18-.52.06-.24-.12-1.01-.37-1.92-1.18-.71-.64-1.19-1.42-1.33-1.66-.14-.24-.01-.37.1-.49.1-.1.24-.26.36-.39.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.29-.74-1.77-.2-.48-.4-.41-.54-.42h-.46c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.69 2.58 4.1 3.62.57.25 1.02.4 1.37.51.58.19 1.11.16 1.52.1.46-.07 1.43-.58 1.63-1.14.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.46-.28Z"
					fill="currentColor"></path>
			</svg>
		</span>
		<span class="bn-label">Chat</span>
	</a>
</nav>

<script is:inline>
	(() => {
		const nav = document.querySelector(".bottom-nav");
		if (!nav) return;
		const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		if (reduce) return;

		let last = window.scrollY;
		let ticking = false;

		const update = () => {
			const y = window.scrollY;
			if (y > last + 8 && y > 220) nav.classList.add("is-hidden");
			else if (y < last - 8) nav.classList.remove("is-hidden");
			last = y;
			ticking = false;
		};

		window.addEventListener(
			"scroll",
			() => {
				if (!ticking) {
					window.requestAnimationFrame(update);
					ticking = true;
				}
			},
			{ passive: true }
		);
	})();
</script>
